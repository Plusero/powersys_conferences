<button type="button" class="theme-toggle" id="theme-toggle">
  {/* One action label per theme; CSS shows only the one for the current
      theme, so the accessible name stays correct without JavaScript. */}
  <span class="visually-hidden" data-theme-label="european-blue">Switch to light theme</span>
  <span class="visually-hidden" data-theme-label="light">Switch to dark theme</span>
  <span class="visually-hidden" data-theme-label="dark">Switch to European blue theme</span>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--star" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="m12 2.25 2.92 6.1 6.58.96-4.75 4.7 1.12 6.64L12 17.5l-5.87 3.15 1.12-6.64-4.75-4.7 6.58-.96L12 2.25Z"></path>
  </svg>
</button>

<script>
  // The inline script in Layout.astro has already applied any saved theme
  // before first paint; this script only handles changes.
  type Theme = "european-blue" | "light" | "dark";

  const DEFAULT_THEME: Theme = "european-blue";
  const STORAGE_VERSION = "2";
  const themes: Theme[] = ["european-blue", "light", "dark"];

  function isTheme(value: unknown): value is Theme {
    return themes.includes(value as Theme);
  }

  function showTheme(theme: Theme) {
    document.documentElement.dataset.theme = theme;
    document
      .querySelector('meta[name="color-scheme"]')
      ?.setAttribute("content", theme === "light" ? "light" : "dark");
  }

  function savedTheme(): Theme {
    try {
      const stored = localStorage.getItem("theme");
      if (localStorage.getItem("theme-version") === STORAGE_VERSION && isTheme(stored)) {
        return stored;
      }
    } catch {
      // Site data blocked.
    }
    return DEFAULT_THEME;
  }

  // Store only an explicit choice; going back to the default clears it, so a
  // future change of default reaches everyone who never picked a theme.
  function saveTheme(theme: Theme) {
    try {
      if (theme === DEFAULT_THEME) {
        localStorage.removeItem("theme");
        localStorage.removeItem("theme-version");
      } else {
        localStorage.setItem("theme-version", STORAGE_VERSION);
        localStorage.setItem("theme", theme);
      }
    } catch {
      // Site data blocked: the theme still applies to this page view.
    }
  }

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme;
    const index = themes.indexOf(isTheme(current) ? current : DEFAULT_THEME);
    const next = themes[(index + 1) % themes.length];
    showTheme(next);
    saveTheme(next);
  });

  // Keep other open tabs in sync with a change made here.
  window.addEventListener("storage", (event) => {
    if (event.key === null || event.key === "theme" || event.key === "theme-version") {
      showTheme(savedTheme());
    }
  });
</script>
