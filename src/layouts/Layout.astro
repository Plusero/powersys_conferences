---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Power Systems Conferences",
  description = "Curated list of power systems and smart grid conferences in Europe.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="european-blue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    {/* The default theme (European blue) is dark; the script below switches
        this to "light" before first paint when the light theme is saved. */}
    <meta name="color-scheme" content="dark" />
    {/* Classic inline script (not a module) so the saved theme applies before
        first paint. Keep it tiny; the toggle logic lives in ThemeToggle. */}
    <script is:inline>
      (function () {
        var theme = "european-blue";
        try {
          var stored = localStorage.getItem("theme");
          if (localStorage.getItem("theme-version") === "2" && (stored === "light" || stored === "dark")) {
            theme = stored;
          }
        } catch (e) {
          // Site data blocked: keep the default theme.
        }
        document.documentElement.dataset.theme = theme;
        if (theme === "light") {
          document.querySelector('meta[name="color-scheme"]').content = "light";
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
    <Font cssVariable="--font-dm-sans" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-fraunces" preload={[{ subset: "latin" }]} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <slot />
  </body>
</html>
